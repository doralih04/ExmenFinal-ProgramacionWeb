{
  "info": {
    "_postman_id": "plataforma-juegos-torneos-collection",
    "name": "Plataforma de Juegos y Torneos — Backend API",
    "description": "Colección de pruebas para el Examen Final de Programación Web II.\nOrganizada por los 5 escenarios del examen. Backend en .NET 8 + Firebase Firestore + JWT.\n\nVariables de entorno requeridas:\n- baseUrl: http://localhost:5288\n- jwtToken: se obtiene del login\n- jugadorId, juegoId, torneoId, participacionId",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [

    {
      "name": "Escenario 1 — Autenticación y Gestión de Jugadores",
      "description": "Integrante 1. Cubre registro, login con JWT y gestión de perfil de jugadores.",
      "item": [

        {
          "name": "1.1 Registro exitoso",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/registro", "host": ["{{baseUrl}}"], "path": ["api","auth","registro"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Carlos Pérez\",\n  \"nombreUsuario\": \"cperez99\",\n  \"correo\": \"cperez@test.com\",\n  \"contrasena\": \"Password123!\",\n  \"rol\": \"jugador\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Status 201', () => pm.response.to.have.status(201));", "pm.test('Exito true', () => pm.expect(pm.response.json().exito).to.be.true);"] }
          }]
        },

        {
          "name": "1.2 Registro correo duplicado (error)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/registro", "host": ["{{baseUrl}}"], "path": ["api","auth","registro"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Otro Usuario\",\n  \"nombreUsuario\": \"otro123\",\n  \"correo\": \"cperez@test.com\",\n  \"contrasena\": \"Password123!\",\n  \"rol\": \"jugador\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Status 409 Conflict', () => pm.response.to.have.status(409));", "pm.test('Exito false', () => pm.expect(pm.response.json().exito).to.be.false);"] }
          }]
        },

        {
          "name": "1.3 Login exitoso → guarda token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"cperez@test.com\",\n  \"contrasena\": \"Password123!\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "if (json.exito && json.data && json.data.token) {",
              "  pm.environment.set('jwtToken', json.data.token);",
              "  console.log('Token guardado en entorno.');",
              "}"
            ]}
          }]
        },

        {
          "name": "1.4 Login credenciales inválidas (error)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"cperez@test.com\",\n  \"contrasena\": \"ContraseñaIncorrecta\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Status 401', () => pm.response.to.have.status(401));"] }
          }]
        },

        {
          "name": "1.5 Obtener jugador por ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/jugadores/{{jugadorId}}", "host": ["{{baseUrl}}"], "path": ["api","jugadores","{{jugadorId}}"] }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));", "pm.test('Sin contraseña', () => pm.expect(pm.response.json().data).to.not.have.property('contrasena'));"] }
          }]
        },

        {
          "name": "1.6 Actualizar perfil del jugador",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/jugadores/{{jugadorId}}/perfil", "host": ["{{baseUrl}}"], "path": ["api","jugadores","{{jugadorId}}","perfil"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Carlos Pérez Actualizado\",\n  \"nombreUsuario\": \"cperez_new\",\n  \"avatar\": \"https://example.com/avatar.png\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] }
          }]
        }

      ]
    },

